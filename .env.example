# Local development only. Choose your own database password.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://haven:change-me@127.0.0.1:5432/haven?sslmode=disable
HAVEN_ADDR=127.0.0.1:8080
# Exact origins allowed to make browser requests to the API.
HAVEN_ORIGINS=http://127.0.0.1:4321,http://localhost:4321

# Optional Enable Banking SANDBOX integration. Set all three together.
# EB_APPLICATION_ID='your-sandbox-application-id'
# EB_PRIVATE_KEY_PATH='/absolute/path/to/private-key.pem'
# EB_REDIRECT_URL='http://127.0.0.1:4321/api/banking/callback'

# Optional persistent wrapping-key path for model API keys (not the API key itself).
# Default: apps/api/.secrets/llm-encryption.key when using make dev.
# HAVEN_LLM_KEY_FILE=/absolute/private/path/llm-encryption.key
