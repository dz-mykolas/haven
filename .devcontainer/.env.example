# Managed local development database; matches .devcontainer/compose.yaml.
# The database is reachable from the workspace at "db", not localhost.
DATABASE_URL=postgres://haven:haven_dev_local@db:5432/haven?sslmode=disable
HAVEN_TEST_DATABASE_URL=postgres://haven:haven_dev_local@db:5432/haven_test?sslmode=disable
HAVEN_E2E_DATABASE_URL=postgres://haven:haven_dev_local@db:5432/haven_e2e?sslmode=disable
HAVEN_ADDR=127.0.0.1:8080
HAVEN_ORIGINS=http://127.0.0.1:4321,http://localhost:4321

# Optional Enable Banking SANDBOX. Setup copies these from an existing .env.
# EB_APPLICATION_ID='your-sandbox-application-id'
# EB_PRIVATE_KEY_PATH='/workspaces/haven/.secrets/enable-banking.pem'
# EB_REDIRECT_URL='http://127.0.0.1:4321/api/banking/callback'

# Optional persistent wrapping-key path for model API keys (not the API key itself).
# Default: apps/api/.secrets/llm-encryption.key when using make dev.
# HAVEN_LLM_KEY_FILE=/absolute/private/path/llm-encryption.key
